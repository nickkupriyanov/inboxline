{
  "name": "@nickkupriyanov/inboxline-core",
  "version": "0.0.0",
  "description": "Framework-free core of Inboxline: notification and adapter contracts, the reducer, the derived view model, the controller, errors and copy.",
  "keywords": [
    "notifications",
    "inbox",
    "notification-center",
    "unread-count",
    "state-machine",
    "headless",
    "dom"
  ],
  "license": "MIT",
  "author": "Nick Kupriyanov",
  "homepage": "https://github.com/nickkupriyanov/inboxline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickkupriyanov/inboxline.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nickkupriyanov/inboxline/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./styles.css": "./dist/inboxline.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
