{
  "name": "inboxline-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Inboxline \u2014 a framework-free notification inbox core with a React binding",
  "packageManager": "pnpm@9.8.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @nickkupriyanov/inboxline-core build && pnpm --filter @nickkupriyanov/inboxline-react build",
    "build:playground": "pnpm --filter @nickkupriyanov/inboxline-playground build",
    "dev": "pnpm --filter @nickkupriyanov/inboxline-playground dev",
    "ssr": "pnpm --filter @nickkupriyanov/inboxline-ssr-example dev",
    "preview": "pnpm --filter @nickkupriyanov/inboxline-playground preview",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @nickkupriyanov/inboxline-react test:watch",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "stand": "python3 -m http.server 4174",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "storybook": "pnpm --filter @nickkupriyanov/inboxline-react storybook",
    "build-storybook": "pnpm --filter @nickkupriyanov/inboxline-react build-storybook",
    "gallery": "pnpm --filter @nickkupriyanov/inboxline-playground exec vite --open /gallery.html"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
